# ============================================================
# SmartRecruit AI — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to Git.
# ============================================================

# --- Aiven MySQL Cloud Database ---
DATABASE_URL=url_key

# --- Google Gemini API ---
GEMINI_API_KEY=api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# --- AI Provider Switch ---
# Values: "cloud" (Google Gemini) | "local" (Ollama on RTX 4060)
AI_PROVIDER=cloud

# --- Local Embedding Model (sentence-transformers, CPU) ---
# Tải trước 1 lần: python download_embedding_model.py
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=models_cache
EMBEDDING_PRELOAD=true

# --- Ollama Local Fallback (only used when AI_PROVIDER=local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Email (Gmail SMTP with App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here

# --- File Storage ---
UPLOAD_DIR=uploads/cv
MAX_UPLOAD_SIZE_MB=5

# --- App Settings ---
APP_ENV=development
SECRET_KEY=352c9f0f9eec5bf4db635ce537c345a619368f4de7cbc3537439a089d14752b7
