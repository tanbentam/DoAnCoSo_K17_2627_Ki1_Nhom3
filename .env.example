# ============================================================
# SmartRecruit AI — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to Git.
# ============================================================

# --- Aiven MySQL Cloud Database ---
DATABASE_URL=url_key
# SSL/TLS: auto (mặc định) | verify (cần DB_SSL_CA) | required | disabled — KHÔNG thêm ?ssl_disabled=... vào DATABASE_URL
DB_SSL_MODE=auto
# CA certificate tải từ Aiven Console → Overview → CA certificate (đường dẫn tương đối theo thư mục backend)
DB_SSL_CA=

# --- Google Gemini API ---
GEMINI_API_KEY=api_key
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng (cách nhau dấu phẩy) khi model chính quá tải / hết hạn mức — mỗi model có hạn mức miễn phí riêng
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1

# --- AI Provider Switch ---
# Values: "cloud" (chỉ Gemini) | "local" (chỉ Ollama trên RTX 4060) | "auto" (Gemini, lỗi thì chuyển Ollama)
AI_PROVIDER=auto

# --- Local Embedding Model (sentence-transformers, CPU) ---
# Tải trước 1 lần: python download_embedding_model.py
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=models_cache
EMBEDDING_PRELOAD=true

# --- Semantic Matching: cosine <= FLOOR -> 0 điểm, cosine >= CEIL -> 100 điểm ---
SEMANTIC_SIM_FLOOR=0.20
SEMANTIC_SIM_CEIL=0.80

# --- Hybrid Matching Score = 40% Hard Filter + 60% Semantic Match ---
HYBRID_HARD_FILTER_WEIGHT=0.4
HYBRID_SEMANTIC_WEIGHT=0.6
SKILL_SEMANTIC_THRESHOLD=0.80

# --- Ollama Local (dùng khi AI_PROVIDER=local, hoặc dự phòng khi AI_PROVIDER=auto) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2

# --- Email tự động cho ứng viên (Mục 7) ---
# smtp: gửi thật qua Gmail | file: ghi thư thành tệp .eml vào backend/outbox/ để xem thử, không gửi | off: tắt
EMAIL_MODE=file
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (mặc định), 465 = SSL
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# App Password 16 ký tự: Tài khoản Google → Bảo mật → Xác minh 2 bước (bật) → Mật khẩu ứng dụng
SMTP_PASSWORD=your_app_password_here
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM_NAME=SmartRecruit AI - Phòng Nhân sự
COMPANY_NAME=SmartRecruit AI
EMAIL_OUTBOX_DIR=outbox

# --- File Storage ---
UPLOAD_DIR=uploads/cv
MAX_UPLOAD_SIZE_MB=5

# --- App Settings ---
APP_ENV=development
SECRET_KEY=352c9f0f9eec5bf4db635ce537c345a619368f4de7cbc3537439a089d14752b7
